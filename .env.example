# Trusted connector identity. Do not expose these values to the browser.
GATEWAY_API_KEY=
GATEWAY_OWNER=
CREDENTIAL_ENCRYPTION_KEY=

# GitHub OAuth application configuration.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://your-host.example/oauth/github/callback

# Existing DeepSeek/provider configuration.
DEEPSEEK_API_KEY=

# Web research. TAVILY_API_KEY enables live search; without it the gateway
# uses the deterministic local fixture provider and labels results as mock.
# RESEARCH_PROVIDER=auto (default) | mock | tavily
TAVILY_API_KEY=
RESEARCH_PROVIDER=auto
