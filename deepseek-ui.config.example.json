{
  "port": 8787,
  "allowedOrigins": ["http://localhost:8090", "http://127.0.0.1:8090"],
  "model": "deepseek-v4-pro",
  "provider": "deepseek",
  "maxRetries": 2,
  "mcp": {
    "servers": {
      "filesystem": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "C:/workspace"],
        "timeoutMs": 30000,
        "retries": 1
      }
    }
  },
  "policy": {
    "rules": [
      { "tool": "load_skill", "decision": "allow" },
      { "tool": "knowledge_search", "decision": "allow" },
      { "tool": "web_search", "decision": "allow" },
      { "tool": "web_fetch", "decision": "allow" },
      { "tool": "web_extract", "decision": "allow" },
      { "tool": "research_sources", "decision": "allow" },
      { "tool": "artifact_create", "decision": "ask" },
      { "tool": "artifact_update", "decision": "ask" }
    ],
    "default": "ask"
  },
  "research": {
    "provider": "auto",
    "maxResults": 8,
    "maxPages": 5,
    "respectRobots": true
  },
  "skills": ["./skills"]
}
